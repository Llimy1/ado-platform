{
  "openapi": "3.0.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "A transport-safe readiness snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Report API liveness and database readiness.",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "ADO API",
    "description": "",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "unavailable"
            ],
            "example": "ready"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-06-24T12:00:00.000Z"
          }
        },
        "required": [
          "status",
          "checkedAt"
        ]
      }
    }
  }
}
