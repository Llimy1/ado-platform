{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "ADO_DATABASE_URL",
    "ADO_API_PORT",
    "ADO_CONTROL_ORIGIN",
    "ADO_API_ENV",
    "NEXT_PUBLIC_ADO_API_ORIGIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "migration:show": {
      "cache": false
    },
    "migration:run": {
      "cache": false
    },
    "openapi:generate": {
      "dependsOn": ["^build"],
      "outputs": ["openapi.json"]
    }
  }
}
